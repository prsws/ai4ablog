---
/**
 * RhythmFigure — picture of a quiet house at night with "the rhythm of the house"
 * drawn over it as a row of small ticks, one longer pause, and no cameras.
 * Used under "8. Quiet Watchfulness" on the Use Cases page.
 *
 * Deliberately NOT a heartbeat line. An ECG-style trace reads as a vital-sign
 * monitor, which Pepa is not (see the site footer and the Terms), and a skipped
 * beat on one looks like a heart stopping. These are uniform ticks, one per
 * household event (a door, a step, the kitchen), with one gap. The gap is marked
 * with words, never color alone.
 *
 * The ticks are EXAMPLE DATA and the caption says so. Nothing here is a reading.
 *
 * Props:
 *   image  the hallway picture (ImageMetadata). Omit for a stand-in panel.
 *   alt    description of the picture. Empty only for the stand-in.
 *   ai     true when the picture is AI-generated (shows the AI Generated badge).
 */
import { Image } from 'astro:assets';

interface Props {
    image?: ImageMetadata;
    alt?: string;
    ai?: boolean;
}
const { image, alt = '', ai = true } = Astro.props;

// Example evening, 9 pm to 3 am, in minutes after 9 pm.
const SPAN = 360;
const GAP_FROM = 190; // about 12:10 am
const GAP_TO = 232; // about 12:52 am
const TICK_EVERY = 13;

// Evenly paced events with a little hand-made jitter so it does not look
// mechanical, and none inside the gap.
const jitter = [0, 2, -1, 3, -2, 1, 0, -3, 2, -1, 1, 3, -2, 0, 2, -1, 1, -2, 3, 0, -1, 2, 1, -3, 0, 2, -1, 1];
const ticks: number[] = [];
for (let i = 1; i * TICK_EVERY < SPAN; i++) {
    const m = i * TICK_EVERY + (jitter[i % jitter.length] ?? 0);
    if (m > GAP_FROM && m < GAP_TO) continue;
    ticks.push(m);
}
const pct = (m: number) => `${((m / SPAN) * 100).toFixed(2)}%`;

const axis = [
    { m: 0, label: '9 pm' },
    { m: 120, label: '11 pm' },
    { m: 240, label: '1 am' },
    { m: 360, label: '3 am' },
];
---

<figure class="rhythm-figure">
    <div class="rhythm-stage">
        {
            image ? (
                <Image
                    src={image}
                    alt={alt}
                    widths={[480, 720, 1028]}
                    sizes="(min-width: 70rem) 56rem, 100vw"
                    format="webp"
                    quality={74}
                    loading="lazy"
                    decoding="async"
                    class="rhythm-img"
                />
            ) : (
                <div class="rhythm-standin" role="img" aria-label="Placeholder for the hallway picture">
                    <span>Hallway picture goes here</span>
                </div>
            )
        }

        <div class="rhythm-overlay" role="img" aria-label="Example evening, 9 pm to 3 am: small ticks every few minutes for household activity, with one longer pause around midnight.">
            <p class="rhythm-title">The rhythm of the house</p>

            <div class="rhythm-track" aria-hidden="true">
                <span class="rhythm-base"></span>
                {ticks.map((m) => <span class="rhythm-tick" style={`left:${pct(m)}`} />)}
                <span class="rhythm-gap" style={`left:${pct(GAP_FROM)}; width:${pct(GAP_TO - GAP_FROM)}`}>
                    <span class="rhythm-gap-label">A longer pause than usual</span>
                </span>
            </div>

            <div class="rhythm-axis" aria-hidden="true">
                {axis.map((a) => <span style={`left:${pct(a.m)}`}>{a.label}</span>)}
            </div>
        </div>
    </div>

    <figcaption>
        {ai && <span class="a4a-badge ai-generated">AI Generated</span>}
        {ai ? 'Illustration of the idea; ' : ''}the ticks are example data, not a real reading. <strong>No camera:</strong>{' '}
        sound and simple sensors, processed inside the house. <strong>In development.</strong>
    </figcaption>
</figure>

<style>
    .rhythm-figure {
        margin: 1.5rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .rhythm-stage {
        position: relative;
        border-radius: var(--pepa-radius-card);
        overflow: hidden;
        box-shadow: var(--pepa-shadow-up);
        aspect-ratio: 16 / 9;
        background: #0b1c27;
    }

    /* Phones: a taller picture, so the overlay does not cover most of it. */
    @media (max-width: 36rem) {
        .rhythm-stage {
            aspect-ratio: 4 / 3;
        }
    }

    .rhythm-stage :global(img),
    .rhythm-standin {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        margin: 0;
    }

    .rhythm-standin {
        display: grid;
        place-items: center;
        background: radial-gradient(ellipse at 30% 70%, #1d3a4a 0%, #0b1c27 70%);
        color: #6f8896;
        font-size: 0.9rem;
    }

    /* Dark scrim along the bottom so the light ticks and labels stay readable
       over any picture, light or dark. */
    .rhythm-overlay {
        position: absolute;
        inset: auto 0 0 0;
        padding: 2.2rem 5% 0.7rem;
        background: linear-gradient(to top, rgba(6, 16, 22, 0.92) 0%, rgba(6, 16, 22, 0.78) 55%, rgba(6, 16, 22, 0) 100%);
        color: #eef2f4;
    }

    .rhythm-title {
        margin: 0 0 0.35rem;
        font-size: clamp(0.78rem, 2.2cqi, 0.95rem);
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .rhythm-track {
        position: relative;
        height: 2.2rem;
    }

    .rhythm-base {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0.45rem;
        height: 1px;
        background: rgba(179, 224, 234, 0.45);
    }

    /* One tick per event, all the same height: no peaks, no pulse shape. */
    .rhythm-tick {
        position: absolute;
        bottom: 0.45rem;
        width: 2px;
        height: 0.95rem;
        margin-left: -1px;
        border-radius: 1px;
        background: #b3e0ea;
    }

    /* The pause: a dashed bracket plus words. */
    .rhythm-gap {
        position: absolute;
        bottom: 0;
        height: 1.4rem;
        border: 1px dashed #e59a2a;
        border-top: 0;
        border-radius: 0 0 6px 6px;
    }

    .rhythm-gap-label {
        position: absolute;
        left: 50%;
        bottom: 100%;
        transform: translateX(-50%);
        white-space: nowrap;
        margin-bottom: 0.15rem;
        font-size: clamp(0.72rem, 2cqi, 0.85rem);
        font-weight: 600;
        color: #f3c887;
    }

    .rhythm-axis {
        position: relative;
        height: 1.1rem;
        margin-top: 0.1rem;
        font-size: 0.72rem;
        color: #b9c8d0;
    }

    .rhythm-axis span {
        position: absolute;
        transform: translateX(-50%);
        white-space: nowrap;
    }
    .rhythm-axis span:first-child {
        transform: none;
    }
    .rhythm-axis span:last-child {
        transform: translateX(-100%);
    }

    .rhythm-figure figcaption {
        font-size: var(--sl-text-sm);
        line-height: 1.5;
        color: var(--sl-color-gray-3);
    }
    .rhythm-figure figcaption .a4a-badge {
        margin-inline-end: 0.4em;
    }
</style>
