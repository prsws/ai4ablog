---
// Site title with a desktop-only toggle that hides or shows the left sidebar.
// Renders Starlight's own SiteTitle unchanged, with the toggle in front of it.
// The early state (no flash) is set by the inline script in astro.config.mjs `head`.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<button
	type="button"
	class="a4a-sidebar-toggle"
	aria-controls="starlight__sidebar"
	aria-expanded="true"
	aria-label="Hide navigation"
	title="Hide navigation"
>
	<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
		stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2" />
		<line x1="9" y1="4" x2="9" y2="20" />
	</svg>
</button>
<Default />

<script>
	const KEY = 'a4a-sidebar';
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('.a4a-sidebar-toggle');

	function sync() {
		if (!button) return;
		const collapsed = root.hasAttribute('data-sidebar-collapsed');
		const label = collapsed ? 'Show navigation' : 'Hide navigation';
		button.setAttribute('aria-expanded', String(!collapsed));
		button.setAttribute('aria-label', label);
		button.title = label;
	}

	button?.addEventListener('click', () => {
		const collapse = !root.hasAttribute('data-sidebar-collapsed');
		root.toggleAttribute('data-sidebar-collapsed', collapse);
		try {
			if (collapse) localStorage.setItem(KEY, 'collapsed');
			else localStorage.removeItem(KEY);
		} catch {}
		sync();
	});

	sync();
</script>

<style>
	.a4a-sidebar-toggle {
		display: none;
	}
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) .a4a-sidebar-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			width: 2.25rem;
			height: 2.25rem;
			margin-inline-end: 0.5rem;
			padding: 0;
			border: 1px solid transparent;
			border-radius: 0.5rem;
			background: transparent;
			color: var(--sl-color-gray-2);
			cursor: pointer;
		}
		:global(:root[data-has-sidebar]) .a4a-sidebar-toggle:hover {
			color: var(--sl-color-white);
			background: var(--sl-color-gray-6);
		}
		:global(:root[data-has-sidebar]) .a4a-sidebar-toggle:focus-visible {
			outline: 2px solid var(--sl-color-text-accent);
			outline-offset: 2px;
		}
	}
</style>
