---
/**
 * PhotoFrame — one picture for a use case, with a caption and a provenance badge.
 * Shares its look with RhythmFigure (case 8): rounded corners, soft shadow.
 *
 * Until the real picture arrives it shows a clearly labelled stand-in, so the
 * page layout can be judged. Do not merge a branch that still shows stand-ins.
 *
 * Props:
 *   image    the picture (ImageMetadata). Omit for the stand-in.
 *   dusk     optional second version of the same picture for the dark theme; then
 *            `image` is the light-theme (day) version. Same switch as the home hero.
 *   altDusk  alt text for the dusk version.
 *   alt      what the picture shows. Required when `image` is given.
 *   hint     stand-in only: what picture belongs here.
 *   caption  one short line under the picture.
 *   badge    provenance badge: 'photo' (real photo), 'screenshot', or 'ai'.
 *   ratio    CSS aspect-ratio, default 16 / 9.
 */
import { Image } from 'astro:assets';

interface Props {
    image?: ImageMetadata;
    alt?: string;
    dusk?: ImageMetadata;
    altDusk?: string;
    hint?: string;
    caption?: string;
    badge?: 'photo' | 'screenshot' | 'ai';
    ratio?: string;
}
const { image, alt = '', dusk, altDusk = '', hint = 'Picture goes here', caption, badge, ratio = '16 / 9' } = Astro.props;

const badges = {
    photo: { cls: 'human-curated', text: 'Real photo' },
    screenshot: { cls: 'human-curated', text: 'Real screenshot' },
    ai: { cls: 'ai-generated', text: 'AI Generated' },
};
const imgAttrs = {
    widths: [480, 720, 1028],
    sizes: '(min-width: 70rem) 56rem, 100vw',
    format: 'webp' as const,
    quality: 74,
    loading: 'lazy' as const,
    decoding: 'async' as const,
};
const b = badge ? badges[badge] : undefined;
---

<figure class="photo-frame">
    <div class="photo-stage" style={`aspect-ratio:${ratio}`}>
        {
            image && dusk ? (
                <>
                    <Image src={image} alt={alt} class="pf-day" {...imgAttrs} />
                    <Image src={dusk} alt={altDusk} class="pf-dusk" {...imgAttrs} />
                </>
            ) : image ? (
                <Image src={image} alt={alt} {...imgAttrs} />
            ) : (
                <div class="photo-standin" role="img" aria-label={`Placeholder: ${hint}`}>
                    <span>{hint}</span>
                </div>
            )
        }
    </div>
    {
        (caption || b) && (
            <figcaption>
                {b && <span class={`a4a-badge ${b.cls}`}>{b.text}</span>}
                {caption}
            </figcaption>
        )
    }
</figure>

<style>
    .photo-frame {
        margin: 1.5rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }
    .photo-stage {
        position: relative;
        border-radius: var(--pepa-radius-card);
        overflow: hidden;
        box-shadow: var(--pepa-shadow-up);
        border: 1px solid var(--sl-color-gray-5);
        background: var(--sl-color-gray-6);
    }
    .photo-stage :global(img),
    .photo-standin {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        margin: 0;
    }
    .photo-standin {
        display: grid;
        place-items: center;
        padding: 1rem;
        text-align: center;
        color: var(--sl-color-gray-3);
        font-size: 0.9rem;
        background: repeating-linear-gradient(
            135deg,
            var(--sl-color-gray-6) 0 14px,
            color-mix(in srgb, var(--sl-color-gray-6) 85%, var(--sl-color-gray-5)) 14px 28px
        );
        outline: 2px dashed var(--sl-color-gray-4);
        outline-offset: -10px;
        border-radius: var(--pepa-radius-card);
    }
    @media (max-width: 36rem) {
        .photo-stage {
            aspect-ratio: 4 / 3 !important;
        }
    }
    .photo-frame figcaption {
        font-size: var(--sl-text-sm);
        line-height: 1.5;
        color: var(--sl-color-gray-3);
    }
    .photo-frame figcaption .a4a-badge {
        margin-inline-end: 0.4em;
    }
</style>

<style is:global>
    /* Day/dusk pair: same switch as the home hero. Dusk is the default (Starlight's
       own default theme); the day picture shows only when the theme is light. */
    .photo-frame .pf-day {
        display: none;
    }
    .photo-frame .pf-dusk {
        display: block;
    }
    :root[data-theme='light'] .photo-frame .pf-day {
        display: block;
    }
    :root[data-theme='light'] .photo-frame .pf-dusk {
        display: none;
    }
</style>
